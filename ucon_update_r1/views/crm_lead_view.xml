<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    


         <record id="view_quotation_stage_mapping_form" model="ir.ui.view">
        <field name="name">quotation.stage.mapping.form</field>
        <field name="model">quotation.stage.mapping</field>
        <field name="arch" type="xml">
            <form string="Quotation State to CRM Lead Stage Mapping">
                <sheet>
                    <group>
                        <field name="sale_order_state"/>
                        <field name="crm_lead_stage"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_quotation_stage_mapping_tree" model="ir.ui.view">
        <field name="name">quotation.stage.mapping.tree</field>
        <field name="model">quotation.stage.mapping</field>
        <field name="arch" type="xml">
            <list string="Statge Mapping" sample="1" multi_edit="1">
                <field name="sale_order_state"/>
                <field name="crm_lead_stage"/>
            </list>
        </field>
    </record>

<record id="action_quotation_stage_mapping" model="ir.actions.act_window">
        <field name="name">Quotation Stage Mappings</field>
        <field name="res_model">quotation.stage.mapping</field>
        <field name="view_mode">list,form</field>
    </record>



    <menuitem 
    id="quotation_stage_mapping_menu" 
    name="Stage Mapping" 
    sequence="-1" 
    parent="crm.menu_crm_config_lead" 
    groups="sales_team.group_sale_manager" 
    action="action_quotation_stage_mapping" />




   

  </data>
</odoo>
