<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.targets</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Targets">
                    <field name="target_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="year"/>

                        

                            <field name="order_booking_target"/>
                            <field name="order_booking_achieved" readonly="1"/>
                            <field name="order_booking_percentage" readonly="1"/>
                            
<!--                         
                            <field name="invoice_target"/>
                            <field name="invoice_achieved"/>
                            <field name="invoice_percentage" readonly="1"/> -->
                        </list>

                    </field>
                </page>
            </xpath>
        </field>
    </record>



      


   




</odoo>
