<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    
    <record id="view_employee_target_list" model="ir.ui.view">
        <field name="name">hr.employee.target.list</field>
        <field name="model">hr.employee.target</field>
        <field name="arch" type="xml">
            <list>
                 <field name="employee_id" />
                <field name="year" />
                <field name="order_booking_target" optional="show" sum="Total"/>
                <field name="order_booking_achieved" optional="hide" sum="Total" />
                <field name="order_booking_percentage" optional="hide"/>
                <field name="invoice_target" optional="show" sum="Total"/>
                <field name="invoice_achieved" optional="hide" sum="Total"/>
                <field name="invoice_percentage" optional="hide"/>
            </list>
        </field>
    </record>


    <record id="view_employee_target_form" model="ir.ui.view">
        <field name="name">hr.employee.target.form</field>
        <field name="model">hr.employee.target</field>
        <field name="arch" type="xml">
            <form string="Employee Target">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="year"/>
                    </group>
                    <group string="Order Booking">
                        <field name="order_booking_target"/>
                        <field name="order_booking_achieved" readonly="1"/>
                        <field name="order_booking_percentage" readonly="1"/>
                    </group>
                    <group string="Invoice">
                        <field name="invoice_target"/>
                        <field name="invoice_achieved"/>
                        <field name="invoice_percentage" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open the list view -->
    <record id="action_employee_target" model="ir.actions.act_window">
        <field name="name">Employee Targets</field>
        <field name="res_model">hr.employee.target</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_employee_target_list"/>
    </record>

  
    <menuitem id="menu_employee_target" name="Employee Targets" parent="hr.menu_human_resources_configuration" action="action_employee_target"/>
</odoo>
