<odoo>
    <data>
        <record id="ucon_crm_lead_form_view_inherit" model="ir.ui.view">
            <field name="name">ucon.crm.lead.form.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="attributes">
                    <attribute name="required">1</attribute>
                </field>

                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="is_ucon_admin" invisible="1"/>
                    <field name="job_type" required="type == 'opportunity'" readonly="not is_ucon_admin"/>
                    <field name="product_ids" widget="many2many_tags" readonly="1"/>
                    <field name="rfq_number" required="type == 'opportunity'" readonly="not is_ucon_admin"/>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="PO Details" name="po_details">
                        <group>
                            <group string="PO Reference Information">
                                <field name="po_date" readonly="not is_ucon_admin"/>
                                <field name="po_ref" readonly="not is_ucon_admin"/>
                            </group>
                            <group string="PO Document Attachments">
                                <field name="po_filename" invisible="1"/>
                                <field name="po_attachment" filename="po_filename" widget="binary" readonly="not is_ucon_admin"/>
                                <field name="po_attachment_ids" widget="many2many_binary" readonly="not is_ucon_admin"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
